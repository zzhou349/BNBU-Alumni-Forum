NODE_ENV=development
HOST=0.0.0.0
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=alumni_dev
DB_PASSWORD=alumni_dev_password
DB_NAME=alumni_wall
DB_CONNECTION_LIMIT=10

# mock：本地返回测试验证码；smtp：通过邮件服务器真实发送
EMAIL_MODE=mock
EMAIL_ALLOWED_DOMAINS=mail.uic.edu.cn,alumni.uic.edu.cn
EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_SEND_INTERVAL_SECONDS=60
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://127.0.0.1:3001
MAX_UPLOAD_MB=10

