/* 页面容器 */
.collect-container {
    padding: 0;
    min-height: 100vh;
    background-color: #f5f5f5;
    padding-top: env(safe-area-inset-top); /* 适配顶部安全区域 */
    padding-bottom: calc(50px + env(safe-area-inset-bottom));
  }
  
  /* 帖子列表 */
  .post-list {
    margin-top: 20rpx;
    background-color: #fff;
  }
  
  /* 空状态样式（复用history页面的空状态样式） */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    text-align: center;
  }
  
  .empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
  }
  
  /* 帖子卡片样式 */
  .post-card {
    padding: 30rpx;
    border-bottom: 1rpx solid #eee;
  }
  
  .post-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .user-info {
    display: flex;
    flex-direction: column;
  }
  
  .user-id {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .post-time {
    font-size: 24rpx;
    color: #999;
  }
  
  .post-title {
    font-size: 30rpx;
    margin-bottom: 20rpx;
    color: #333;
    line-height: 1.6;
    display: block; /* 使文本块级显示 */
  white-space: normal; /* 允许正常换行 */
  word-wrap: break-word; /* 允许长单词换行 */
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 超出部分显示省略号 */
  display: -webkit-box; /* 弹性盒模型 */
  -webkit-line-clamp: 2; /* 最多显示2行 */
  -webkit-box-orient: vertical; /* 垂直排列 */
  }
  
  /* 图片展示区域 */
  .post-images {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -5rpx 20rpx;
    pointer-events: none; /* 允许点击事件穿透到父元素 */
  }
  
  .post-image {
    width: 150rpx;
    height: 150rpx;
    margin: 5rpx;
    pointer-events: auto; /* 图片本身可以接收点击事件 */
    border-radius: 12rpx; /* 增加圆角，优化视觉效果 */
  }
  
  /* 专区标签 */
  .post-zone-tags {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 25rpx;
  }
  
  .post-zone-tag {
    background-color: #e6f3ff;
    color: #1989fa;
    font-size: 24rpx;
    padding: 6rpx 15rpx;
    border-radius: 6rpx;
    margin-right: 15rpx;
    margin-bottom: 10rpx;
  }
  
  /* 互动按钮区域 */
  .post-actions {
    display: flex;
    justify-content: space-around;
    border-top: 1rpx solid #f5f5f5;
    padding-top: 20rpx;
  }
  
  .action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 24rpx;
    color: #666;
  }
  
  .action-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 10rpx;
  }