<!-- 用户信息页面 -->
<view class="user-info-container">

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-header">
      <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view class="user-details">
        <text class="username">{{userInfo.username}}</text>
        <text class="user-id">ID: {{userInfo.userId}}</text>
        <text class="bio">{{userInfo.bio || '这个人很懒，什么都没写~'}}</text>
      </view>
    </view>
    
    <!-- 用户统计信息 -->
    <view class="user-stats">
      <view class="stat-item" bindtap="openRelations" data-mode="followers">
        <text class="stat-number">{{userInfo.postCount || 0}}</text>
        <text class="stat-label">帖子</text>
      </view>
      <view class="stat-item" bindtap="openRelations" data-mode="following">
        <text class="stat-number">{{userInfo.followersCount || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{userInfo.followingCount || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn primary-btn" bindtap="sendPrivateMessage">
      <text>私聊</text>
    </button>
    <button class="action-btn secondary-btn" bindtap="handleFollow">
      <text>{{isFollowing ? '已关注' : '关注'}}</text>
    </button>
  </view>

  <!-- 用户帖子列表 -->
    <view class="posts-list" wx:if="{{userPosts.length > 0}}">
        <block wx:for="{{userPosts}}" wx:key="id">
        <view class="post-card" bindtap="navigateToPostDetail" data-id="{{item.id}}">
            <!-- 头像 & 用户信息 -->
            <view class="post-header">
            <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
            <view class="user-info">
                <text class="user-id">{{userInfo.username}}</text>
                <text class="post-time">{{item.time}}</text>
            </view>
            </view>
            
            <!-- 帖子标题 -->
            <view class="post-title">
                <text>{{item.title}}</text>
            </view>
            
            <!-- 图片展示区域 -->
            <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
            <block wx:for="{{item.images}}" wx:key="index">
                <image 
                class="post-image" 
                src="{{item}}" 
                mode="aspectFill"
                bindtap="previewImage"
                data-url="{{item}}"
                data-index="{{index}}"
                data-id="{{item.id}}"
                ></image>
            </block>
            </view>
            
            <!-- 专区标签：增加间距 -->
            <view class="post-zone-tags" wx:if="{{item.zone && item.zone.length > 0}}">
            <block wx:for="{{item.zone}}" wx:key="index">
                <text class="post-zone-tag">#{{item}}</text>
            </block>
            </view>
            
            <!-- 互动按钮 -->
            <view class="post-actions">
            <!-- 收藏按钮 -->
            <view class="action-item" catchtap="handleCollect" data-id="{{item.id}}">
                <image src="{{item.isCollected ? '/assets/collected.png' : '/assets/collect.png'}}" class="action-icon"></image>
                <text>{{item.collectCount || 0}}</text>
            </view>

            <!-- 点赞按钮 -->
            <view class="action-item" catchtap="handleLike" data-id="{{item.id}}">
                <image src="{{item.isLiked ? '/assets/liked.png' : '/assets/like.png'}}" class="action-icon"></image>
                <text>{{item.likeCount || 0}}</text>
            </view>

            <!-- 评论按钮 -->
            <view class="action-item" catchtap="navigateToPostDetail" data-id="{{item.id}}">
                <image src="/assets/comment.png" class="action-icon"></image>
                <text>{{item.commentCount || 0}}</text>
            </view>
            </view>
        </view>
        </block>
    </view>
</view>
