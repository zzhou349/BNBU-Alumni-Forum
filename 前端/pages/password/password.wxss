.password-page {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}

.password-card {
  padding: 34rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

.page-desc {
  display: block;
  margin-bottom: 30rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-input {
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.code-row {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 220rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  color: #0166a4;
  font-size: 25rpx;
  line-height: 88rpx;
  background: #eef7fc;
}

.mock-code {
  margin: -8rpx 0 24rpx;
  padding: 18rpx;
  border: 1rpx dashed #0166a4;
  border-radius: 10rpx;
  color: #666;
  font-size: 25rpx;
  text-align: center;
}

.mock-code text {
  color: #0166a4;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
}

.primary-btn {
  margin-top: 12rpx;
  color: #fff;
  background: #0166a4;
}
