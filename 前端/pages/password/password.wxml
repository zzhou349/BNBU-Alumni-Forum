<view class="password-page">
  <view class="password-card" wx:if="{{mode === 'change'}}">
    <text class="page-desc">修改成功后需要使用新密码重新登录</text>
    <input class="form-input" password placeholder="请输入原密码" data-field="oldPassword" bindinput="onInput" />
    <input class="form-input" password placeholder="请输入新密码（至少6位）" data-field="newPassword" bindinput="onInput" />
    <input class="form-input" password placeholder="再次输入新密码" data-field="confirmPassword" bindinput="onInput" />
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitChange">确认修改</button>
  </view>

  <view class="password-card" wx:else>
    <text class="page-desc">使用注册邮箱或已认证学校邮箱重置密码</text>
    <input class="form-input" type="text" placeholder="请输入邮箱" data-field="email" bindinput="onInput" />
    <view class="code-row">
      <input class="form-input code-input" type="number" maxlength="6" placeholder="6位验证码" data-field="code" bindinput="onInput" />
      <button class="code-btn" disabled="{{!canSendCode || !email}}" bindtap="sendResetCode">{{sendCodeText}}</button>
    </view>
    <view class="mock-code" wx:if="{{testCode}}">开发模式验证码：<text>{{testCode}}</text></view>
    <input class="form-input" password placeholder="请输入新密码（至少6位）" data-field="newPassword" bindinput="onInput" />
    <input class="form-input" password placeholder="再次输入新密码" data-field="confirmPassword" bindinput="onInput" />
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || !codeSent}}" bindtap="submitReset">确认重置</button>
  </view>
</view>
