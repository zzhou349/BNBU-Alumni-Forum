.admin-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

.main-tabs,
.status-tabs,
.card-head,
.actions {
  display: flex;
}

.main-tabs {
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.tab {
  flex: 1;
  padding: 22rpx;
  color: #666;
  text-align: center;
}

.tab.active {
  color: #0166a4;
  font-weight: bold;
  border-bottom: 4rpx solid #0166a4;
}

.status-tabs {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.status-chip {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  color: #666;
  background: #fff;
  font-size: 25rpx;
}

.status-chip.active {
  color: #fff;
  background: #0166a4;
}

.manage-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 14rpx;
  background: #fff;
}

.card-head {
  justify-content: space-between;
  color: #999;
  font-size: 23rpx;
}

.tag {
  color: #0166a4;
}

.title {
  margin: 18rpx 0 10rpx;
  color: #222;
  font-size: 31rpx;
  font-weight: bold;
}

.meta,
.reason {
  margin-top: 10rpx;
  color: #777;
  font-size: 25rpx;
  line-height: 1.6;
}

.reason {
  color: #333;
}

.actions {
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
}

.actions button {
  margin: 0;
}

.actions .danger {
  color: #fff;
  background: #d94841;
}

.empty,
.loading,
.error {
  padding: 80rpx 0;
  color: #999;
  text-align: center;
}

.error {
  color: #d94841;
}
