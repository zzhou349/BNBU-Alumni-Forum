/* 主页样式 */
.home-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
}

/* 搜索栏样式 */
.search-bar {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.search-input-container {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 25rpx;
  padding: 0 20rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-button {
  background-color: #0166A4;
  color: #fff;
  font-size: 28rpx;
  padding: 5rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 15rpx;
  border: none;
}

/* 热门事件样式 */
.hot-events-container {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.hot-events-swiper {
  height: 300rpx;
}

.hot-event-card {
  width: 100%;
  height: 100%;
}

.event-image {
  width: 100%;
  height: 100%;
}

/* 专区标签样式 */
.zone-container {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.zone-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.zone-item {
  background-color: #f0f8ff;
  padding: 20rpx;
  border-radius: 15rpx;
  text-align: center;
  font-size: 28rpx;
  color: #0166A4;
  border: 2rpx solid #e6f3ff;
}

/* 悬浮按钮样式 */
.floating-buttons {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  z-index: 1000;
  bottom: calc(120rpx + 50px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.floating-button {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.floating-top-button {
  background-color: white;
}

.floating-search-button {
  background-color: #0166A4;
}

.button-icon {
  width: 50rpx;
  height: 50rpx;
}

/* 帖子列表样式 */
.post-list {
  padding: 0 20rpx 20rpx;
}

.post-card {
  background-color: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-id {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

/* 更多按钮容器 - 关键定位父元素 */
.post-more {
    position: relative; /* 作为菜单的定位容器 */
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60rpx;
    height: 60rpx;
    margin-left: auto; /* 靠右显示 */
  }

  .post-more:active .more-icon {
    opacity: 0.8; /* 点击反馈 */
  }


/* 更多图标样式 */
.more-icon {
    width: 40rpx;
    height: 20rpx;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

/* 上下文菜单样式 - 作为附属弹窗出现在按钮下方 */
.context-menu {
    position: absolute; /* 相对于按钮定位 */
    z-index: 10000;
    background-color: #fff;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15); /* 柔和阴影增强附属感 */
    min-width: 180rpx; /* 适当宽度 */
    overflow: hidden;
    transform-origin: top center; /* 以顶部中心为原点，从按钮下方展开 */
    margin-top: 10rpx; /* 与按钮保持小距离 */
  }

  /* 增加连接指示线，强化附属关系 */
  .context-menu::before {
    content: "";
    position: absolute;
    top: -10rpx;
    left: 50%; /* 水平居中 */
    transform: translateX(-50%); /* 精准居中 */
    border-width: 0 10rpx 10rpx;
    border-style: solid;
    border-color: transparent transparent #fff transparent;
  }


/* 菜单项样式 */
.menu-item {
    padding: 22rpx 30rpx;
    font-size: 28rpx;
    color: #333;
    text-align: left;
    border-bottom: 1rpx solid #f5f5f5;
    transition: background-color 0.2s;
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .menu-item:active {
    background-color: #f5f5f5;
  }

.post-time {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 5rpx;
}

.post-title {
  margin-bottom: 20rpx;
}

.post-title text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: block; /* 使文本块级显示 */
  white-space: normal; /* 允许正常换行 */
  word-wrap: break-word; /* 允许长单词换行 */
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 超出部分显示省略号 */
  display: -webkit-box; /* 弹性盒模型 */
  -webkit-line-clamp: 2; /* 最多显示2行 */
  -webkit-box-orient: vertical; /* 垂直排列 */
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  margin: 5rpx;
}

.post-zone-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.post-zone-tag {
  background-color: #f0f8ff;
  color: #007aff;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}

.action-item text {
  font-size: 28rpx;
  color: #666;
}

.list-status {
  padding: 28rpx 0 40rpx;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}
