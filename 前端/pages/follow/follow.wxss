/* 基础容器样式 */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding-bottom: calc(50px + env(safe-area-inset-bottom));
  }
  
  /* 加载中样式 */
  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    font-size: 26rpx;
    color: #666;
  }
  
  .loading-spinner {
    width: 24rpx;
    height: 24rpx;
    border: 3rpx solid #ddd;
    border-top-color: #0166A4;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 10rpx;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  /* 错误提示 */
  .error-message {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    background-color: #fef0f0;
    color: #f56c6c;
    border-radius: 8rpx;
    margin: 20rpx 15rpx;
    font-size: 26rpx;
  }
  
  .reload-btn {
    background-color: #f56c6c !important;
    color: #fff !important;
    font-size: 24rpx !important;
    padding: 6rpx 16rpx !important;
    border-radius: 30rpx !important;
  }
  
  /* 未登录提示 */
  .unlogin-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    text-align: center;
  }
  
  .hint-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
  }
  
  .hint-text {
    font-size: 32rpx;
    color: #999;
    margin-bottom: 40rpx;
  }
  
  .login-btn {
    background-color: #0166A4;
    color: white;
    padding: 15rpx 60rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
  }
  
  /* 空状态样式 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    text-align: center;
  }
  
  .empty-img {
    width: 200rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
  }
  
  /* 用户列表样式 */
  .user-list {
    padding: 20rpx 15rpx;
  }
  
  .user-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 25rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .user-avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50rpx;
    margin-right: 25rpx;
  }
  
  .user-info {
    flex: 1;
    padding: 5rpx 0;
    min-width: 0; /* 解决文本溢出问题 */
  }
  
  .user-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #0166A4;
    margin-bottom: 10rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .user-bio {
    font-size: 26rpx;
    color: #666;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 1; /* 只显示一行简介 */
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 8rpx;
  }
  
  .follow-time {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 取消关注按钮 */
  .unfollow-btn {
    background-color: #f5f5f5;
    color: #666;
    border: 1rpx solid #ddd;
    padding: 12rpx 30rpx;
    border-radius: 40rpx;
    font-size: 26rpx;
    height: auto;
    line-height: normal;
  }

  .relation-summary,
  .list-end {
    padding: 24rpx 30rpx;
    color: #999;
    font-size: 25rpx;
    text-align: center;
  }
