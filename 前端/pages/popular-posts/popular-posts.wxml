<view class="zones-container">
  <!-- 顶部专区信息 -->
  <view class="header">
    <view class="zone-title">高赞合集</view>
    <view class="zone-info">嗯？校友们精心挑选出{{zoneData.postCount}} 条高赞帖子！</view>
    <view class="zone-description">精选高点赞、高收藏的热门内容</view>
  </view>

  <!-- 内容区域 -->
  <view class="content-container">
    <view class="tabs">
      <view
        class="tab {{activeTab === 'hot' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="hot"
      >
        热门
      </view>
      <view
        class="tab {{activeTab === 'new' ? 'active' : ''}}"
        bindtap="switchTab"
        data-tab="new"
      >
        最新
      </view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{isLoading}}" class="loading-container">
        <text>加载中...</text>
    </view>

    <!-- 帖子列表 - 内容为空提示 -->
    <view class="empty-container" wx:if="{{posts.length === 0 && !isLoading}}">
      <text class="empty-text">暂无高赞内容</text>
    </view>

    <!-- 帖子列表 -->
    <view class="post-list" wx:if="{{posts.length > 0}}">
      <block wx:for="{{posts}}" wx:key="id">
        <view class="post-card" bindtap="navigateToPostDetail" data-id="{{item.id}}">
          <!-- 头像 & 用户信息 -->
          <view class="post-header">
            <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="user-info">
              <text class="user-id">{{item.author}}</text>
              <text class="post-time">{{formatTime(item.time)}}</text>
            </view>
          </view>

          <!-- 帖子内容 -->
          <view class="post-title">
            <text>{{item.title}}</text>
          </view>

          <!-- 图片展示区域 -->
          <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
            <block wx:for="{{item.images}}" wx:key="index">
              <image
                class="post-image"
                src="{{item}}"
                mode="aspectFill"
                bindtap="previewImage"
                data-url="{{item}}"
                data-index="{{index}}"
              ></image>
            </block>
          </view>

          <!-- 专区信息 -->
          <view class="post-zone-tags">
            <text class="post-zone-tag">#{{item.zone}}</text>
            <text class="hot-tag" wx:if="{{item.likeCount >= 100}}">🔥 热门</text>
          </view>

          <!-- 互动按钮 -->
          <view class="post-actions">
            <!-- 点赞按钮 -->
            <view class="action-item" catchtap="handleLike" data-id="{{item.id}}">
              <image src="{{item.isLiked ? '/assets/liked.png' : '/assets/like.png'}}" class="action-icon"></image>
              <text>{{item.likeCount || 0}}</text>
            </view>

            <!-- 评论按钮 -->
            <view class="action-item" catchtap="navigateToPostDetail" data-id="{{item.id}}">
              <image src="/assets/comment.png" class="action-icon"></image>
              <text>{{item.commentCount || 0}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{!isEnd && posts.length > 0}}">
        <text bindtap="loadMore" wx:if="{{!isLoadingMore}}">加载更多</text>
        <view wx:else>
          <text>正在加载...</text>
        </view>
      </view>

      <!-- 底部提示 -->
      <view class="footer-tips" wx:if="{{isEnd && posts.length > 0}}">
        <text>没有更多内容了</text>
      </view>
    </view>
  </view>
</view>
