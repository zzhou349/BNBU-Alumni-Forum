.message-container {
  padding: 20rpx;
  padding-bottom: calc(50px + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #666;
}

.tab.active {
  color: #0166A4;
  font-weight: bold;
  border-bottom: 4rpx solid #0166A4;
}

.activity-item, .chat-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.content {
  flex: 1;
}

.username, .name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.comment {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.post-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.name-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.last-message {
  font-size: 28rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.login-prompt {
  text-align: center;
  padding: 100rpx 0;
  color: #666;
}

.empty-tip {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
}

.container {
    padding: 20rpx;
    background-color: #f8f8f8;
    min-height: 100vh;
  }
  
  .tabs {
    display: flex;
    background: #fff;
    border-radius: 10rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
  }
  
  .tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 32rpx;
    color: #666;
  }
  
  .tab.active {
    color: #0166A4;
    font-weight: bold;
    border-bottom: 4rpx solid #0166A4;
  }
  
  .login-prompt {
    text-align: center;
    padding: 100rpx 0;
    background: #fff;
    border-radius: 10rpx;
  }
  
  .login-prompt button {
    width: 200rpx;
    margin-top: 30rpx;
  }
  
  .activity-list {
    background: #fff;
    border-radius: 10rpx;
    padding: 20rpx;
  }
  
  .activity-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #eee;
  }
  
  .activity-item:last-child {
    border-bottom: none;
  }
  
  .activity-item .avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .activity-item .content {
    flex: 1;
  }
  
  .username {
    font-weight: bold;
    font-size: 32rpx;
    margin-bottom: 10rpx;
  }
  
  .comment {
    font-size: 30rpx;
    color: #333;
    margin-bottom: 10rpx;
  }
  
  .post-title {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 10rpx;
  }
  
  .time {
    font-size: 24rpx;
    color: #999;
  }
  
  .loading {
    text-align: center;
    padding: 40rpx 0;
  }
  
  .loading image {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 20rpx;
  }
  
  .empty-tip {
    text-align: center;
    padding: 80rpx 0;
    color: #999;
    font-size: 30rpx;
  }
  
  .chat-list {
    background: #fff;
    border-radius: 10rpx;
    padding: 0 20rpx;
  }
  
  .chat-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #eee;
  }
  
  .chat-item:last-child {
    border-bottom: none;
  }
  
  .chat-item .avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .chat-item .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .name-time {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10rpx;
  }
  
  .name {
    font-size: 34rpx;
    font-weight: bold;
  }
  
  .time {
    font-size: 26rpx;
    color: #999;
  }
  
  .last-message {
    font-size: 30rpx;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 500rpx;
  }

  .error-message {
    background-color: #fff2f0;
    color: #ff4d4f;
    padding: 20rpx;
    border-radius: 8rpx;
    margin-bottom: 20rpx;
    text-align: center;
    font-size: 28rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .error-message button {
    margin-top: 20rpx;
    background-color: #ff4d4f;
    color: white;
    width: 200rpx;
  }

  .error-message {
    background-color: #fff2f0;
    color: #ff4d4f;
    padding: 20rpx;
    border-radius: 8rpx;
    margin-bottom: 20rpx;
    text-align: center;
    font-size: 28rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .error-message text {
    margin-bottom: 15rpx;
  }
  
  .reload-btn {
    background-color: #0166A4;
    color: white;
    width: 200rpx;
    margin-top: 10rpx;
  }

/* 用户信息弹窗样式 */
.user-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-popup {
  position: absolute;
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  max-width: 400rpx;
  z-index: 1001;
}

.popup-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.popup-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #e0e0e0;
}

.popup-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.popup-username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-signature {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  max-width: 300rpx;
  word-wrap: break-word;
}

.popup-id {
  font-size: 20rpx;
  color: #999;
}

.popup-message-btn {
  background: #007aff;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  margin-top: 8rpx;
}

.tab-badge,
.unread-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #e5484d;
  font-size: 20rpx;
  box-sizing: border-box;
}

.message-toolbar {
  padding: 16rpx 20rpx;
  color: #0166a4;
  font-size: 25rpx;
  text-align: right;
}

.activity-item {
  position: relative;
}

.activity-item.unread {
  background: #f1f8fc;
}

.unread-dot {
  position: absolute;
  top: 24rpx;
  left: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e5484d;
}

.unread-badge {
  flex-shrink: 0;
  margin-left: 14rpx;
}
