/* 页面布局 - 恢复顶部原始状态 */
.post-container {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #fff;
    padding: 0;
    box-sizing: border-box;
    padding-bottom: calc(50px + env(safe-area-inset-bottom));
  }
  
  .post-form {
    background-color: #fff;
    padding: 20rpx;
    width: calc(100% - 40rpx); /* 保持宽度适配 */
  }
  
  /* 输入框样式保持不变 */
  .post-input {
    width: 100%;
    font-size: 28rpx;
    border-bottom: 1rpx solid #ddd;
    padding: 10rpx 0;
    margin-top: 10rpx;
  }
  
  .post-textarea {
    width: 100%;
    height: 750rpx;
    font-size: 28rpx;
    border: none;
    margin-top: 20rpx;
  }
  
  /* 选择专区样式保持不变 */
  .picker-btn {
    background-color: #f8f8f8;
    padding: 10rpx;
    border-radius: 8rpx;
    text-align: center;
  }
  
  /* 提交按钮样式保持不变 */
  .submit-btn {
    background-color: #0166A4;
    color: white;
    border-radius: 16rpx;
    padding: 15rpx;
    font-size: 28rpx;
    margin-top: 20rpx;
  } 
  
  /* 图片上传区域样式保持不变 */
  .image-upload-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15rpx;
    margin-top: 20rpx;
  }
  
  .image-upload-btn {
    width: 150rpx;
    height: 150rpx;
    background-color: #fff;
    border: 2rpx dashed #ddd;
    border-radius: 10rpx;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .plus-icon {
    font-size: 60rpx;
    color: #999;
  }
  
  .image-preview-item {
    position: relative;
    width: 150rpx;
    height: 150rpx;
    border-radius: 10rpx;
    overflow: hidden;
  }
  
  .preview-image {
    width: 100%;
    height: 100%;
  }
  
  .remove-image-btn {
    position: absolute;
    top: 0;
    right: 0;
    width: 40rpx;
    height: 40rpx;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 0 0 0 10rpx;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .remove-icon {
    font-size: 30rpx;
    color: white;
    font-weight: bold;
  }