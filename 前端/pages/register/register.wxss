/* 页面容器 */
.register-page {
    padding: 20rpx;
    background: #f8f8f8;
  }
  
  /* 表单 */
  .form {
    background: white;
    padding: 20rpx;
    border-radius: 10rpx;
  }
  
  /* 表单项 */
  .form-item {
    margin-bottom: 30rpx;
  }
  
  .form-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 10rpx;
    display: block;
  }

  /* 添加邮箱后缀样式 */
  .form-item {
    position: relative;
  }
  
  .email-suffix {
    position: absolute;
    right: 15px;
    bottom: 10px;
    color: #333;
  }
  
  /* 输入框 */
  .form-input {
    border: 1rpx solid #e0e0e0;
    padding: 15rpx;
    font-size: 28rpx;
    border-radius: 10rpx;
  }
  
  /* 头像 */
  .avatar-wrapper {
    display: flex;
    align-items: center;
  }
  
  .avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .change-text {
    font-size: 24rpx;
    color: #007aff;
  }
  
  /* 文本域 */
  .form-textarea {
    border: 1rpx solid #e0e0e0;
    padding: 15rpx;
    font-size: 28rpx;
    border-radius: 10rpx;
    height: 200rpx;
  }
  
  /* 注册按钮 */
  .register-btn {
    background: #0166A1;
    color: white;
    border: none;
    padding: 20rpx;
    font-size: 28rpx;
    border-radius: 10rpx;
    margin-top: 40rpx;
  }