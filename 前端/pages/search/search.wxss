/* 基础容器样式 */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
    padding-bottom: calc(50px + env(safe-area-inset-bottom));
  }
  
  /* 搜索栏样式 */
  .search-bar {
    padding: 20rpx 30rpx;
    background-color: #fff;
    border-bottom: 1px solid #eee;
  }
  
  .search-input-container {
    display: flex;
    align-items: center;
    background-color: #f5f5f5;
    border-radius: 40rpx;
    padding: 0 20rpx;
    height: 80rpx;
  }
  
  .search-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 15rpx;
  }
  
  .search-input {
    flex: 1;
    height: 100%;
    font-size: 28rpx;
  }
  
  .search-button {
    background-color: #0166A4;
    color: #fff;
    font-size: 28rpx;
    padding: 0 30rpx;
    height: 60rpx;
    line-height: 60rpx;
    border-radius: 30rpx;
    margin: 0;
  }
  
  /* 标签栏样式 */
  .tabs {
    display: flex;
    background-color: #fff;
    border-bottom: 1rpx solid #eee;
  }
  
  .tab {
    flex: 1;
    text-align: center;
    padding: 25rpx 0;
    font-size: 30rpx;
    color: #666;
    position: relative;
  }
  
  .tab.active {
    color: #0166A4;
    font-weight: bold;
  }
  
  .tab.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 30%;
    width: 40%;
    height: 4rpx;
    background-color: #0166A4;
    border-radius: 2rpx;
  }
  
  /* 标签内容区通用样式 */
  .tab-content {
    padding: 20rpx 0;
  }
  
  /* 搜索前提示 */
  .search-hint {
    text-align: center;
    padding: 100rpx 0;
    color: #999;
    font-size: 28rpx;
  }
  
  /* 加载中样式 */
  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60rpx 0;
    font-size: 26rpx;
    color: #666;
  }
  
  .loading-spinner {
    width: 24rpx;
    height: 24rpx;
    border: 3rpx solid #ddd;
    border-top-color: #0166A4;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 10rpx;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  /* 错误提示 */
  .error-message {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 30rpx;
    background-color: #fef0f0;
    color: #f56c6c;
    border-radius: 8rpx;
    margin: 20rpx 15rpx;
    font-size: 26rpx;
  }
  
  .reload-btn {
    background-color: #f56c6c !important;
    color: #fff !important;
    font-size: 24rpx !important;
    padding: 6rpx 16rpx !important;
    border-radius: 30rpx !important;
  }
  
  /* 帖子列表样式（改为与收藏页一致的样式） */
  .post-list {
    margin-top: 20rpx;
    background-color: #fff;
  }
  
  /* 空状态样式（改为与收藏页一致的样式） */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    text-align: center;
  }
  
  .empty-icon {
    font-size: 120rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #999;
  }
  
  /* 帖子卡片样式（改为与收藏页一致的样式） */
  .post-card {
    padding: 30rpx;
    border-bottom: 1rpx solid #eee;
  }
  
  .post-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .user-info {
    display: flex;
    flex-direction: column;
  }
  
  .user-id {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
  }
  
  .post-time {
    font-size: 24rpx;
    color: #999;
  }
  
  .post-title {
    font-size: 30rpx;
    margin-bottom: 20rpx;
    color: #333;
    line-height: 1.6;
    display: block; /* 使文本块级显示 */
  white-space: normal; /* 允许正常换行 */
  word-wrap: break-word; /* 允许长单词换行 */
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 超出部分显示省略号 */
  display: -webkit-box; /* 弹性盒模型 */
  -webkit-line-clamp: 2; /* 最多显示2行 */
  -webkit-box-orient: vertical; /* 垂直排列 */
  }
  
  /* 图片展示区域 */
  .post-images {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -5rpx 20rpx;
    pointer-events: none;
  }
  
  .post-image {
    width: 150rpx;
    height: 150rpx;
    margin: 5rpx;
    pointer-events: auto;
    border-radius: 12rpx;
  }
  
  /* 专区标签 */
  .post-zone-tags {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 25rpx;
  }
  
  .post-zone-tag {
    background-color: #e6f3ff;
    color: #1989fa;
    font-size: 24rpx;
    padding: 6rpx 15rpx;
    border-radius: 6rpx;
    margin-right: 15rpx;
    margin-bottom: 10rpx;
  }
  
  /* 互动按钮区域 */
  .post-actions {
    display: flex;
    justify-content: space-around;
    border-top: 1rpx solid #f5f5f5;
    padding-top: 20rpx;
  }
  
  .action-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 24rpx;
    color: #666;
  }
  
  .action-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 10rpx;
  }
  
  /* 加载更多 */
  .load-more {
    text-align: center;
    font-size: 26rpx;
    color: #666;
    padding: 20rpx 0;
    background-color: #fff;
    border-radius: 8rpx;
    margin: 0 15rpx 20rpx;
  }
  
  /* 用户列表样式（保持不变） */
  .user-list {
    padding: 0 15rpx;
  }
  
  .user-item {
    display: flex;
    align-items: flex-start;
    background-color: #fff;
    border-radius: 16rpx;
    padding: 25rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  }
  
  .user-avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50rpx;
    margin-right: 25rpx;
  }
  
  .user-info {
    flex: 1;
    padding: 5rpx 0;
  }
  
  .user-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #0166A4;
    margin-bottom: 10rpx;
  }
  
  .user-bio {
    font-size: 26rpx;
    color: #666;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }